@model IEnumerable<Order>

<h2>Order History</h2>

<table border="1">
    <thead>
        <tr>
            <th>Branch</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Type</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Branch.Name</td>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.OrderType</td>
                <td>@item.CreatedAt.ToString("MM/dd/yyyy hh:mm tt")</td>
            </tr>
        }
    </tbody>
</table>
